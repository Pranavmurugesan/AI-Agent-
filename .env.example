# Application Server Config
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database Credentials
DATABASE_URL=jdbc:postgresql://localhost:5432/ailead_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres_secret_pass

# Security & Authentication Secrets (DO NOT COMMIT REAL VALUES)
JWT_SECRET=replace_with_a_secure_random_256bit_hex_secret_key_in_production
JWT_EXPIRATION_MS=86400000
